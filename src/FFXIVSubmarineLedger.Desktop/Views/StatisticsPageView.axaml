<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FFXIVSubmarineLedger.Desktop.Localization"
             xmlns:vm="clr-namespace:FFXIVSubmarineLedger.Desktop.ViewModels"
             xmlns:controls="clr-namespace:FFXIVSubmarineLedger.Desktop.Controls"
             x:Class="FFXIVSubmarineLedger.Desktop.Views.StatisticsPageView"
             x:DataType="vm:StatisticsPageViewModel"
             x:CompileBindings="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14">

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="{loc:Tr stats.total}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding TotalLabel}" />
                        <TextBlock FontSize="11" Opacity="0.5"
                                   IsVisible="{Binding TotalDetailLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding TotalDetailLabel}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="{loc:Tr stats.perDay}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding AveragePerDayLabel}" />
                        <TextBlock FontSize="11" Opacity="0.5"
                                   IsVisible="{Binding AveragePerDayDetailLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding AveragePerDayDetailLabel}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="{loc:Tr stats.perMonth}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding AveragePerMonthLabel}" />
                        <TextBlock FontSize="11" Opacity="0.5"
                                   IsVisible="{Binding AveragePerMonthDetailLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding AveragePerMonthDetailLabel}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="{loc:Tr stats.perYear}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding AveragePerYearLabel}" />
                        <TextBlock FontSize="11" Opacity="0.5"
                                   IsVisible="{Binding AveragePerYearDetailLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding AveragePerYearDetailLabel}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="16" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap" Text="{Binding SpanLabel}" />
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TrendTitle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button FontSize="11" Content="{loc:Tr stats.byDay}" Command="{Binding ShowDailyCommand}" />
                            <Button FontSize="11" Content="{loc:Tr stats.byMonth}" Command="{Binding ShowMonthlyCommand}" />
                            <Button FontSize="11" Content="{loc:Tr stats.exportCsv}" Command="{Binding ExportCsvCommand}" />
                        </StackPanel>
                    </Grid>
                    <controls:TrendChart Height="170" Series="{Binding Trend}" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr stats.characterShare}" />

                    <ItemsControl ItemsSource="{Binding Characters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterShareRowViewModel">
                                <Grid Margin="0,5" ColumnDefinitions="180,60,*,120" ColumnSpacing="12">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding CharacterName}" />
                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                               Text="{Binding RecordCountLabel}" />
                                    <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100"
                                                 VerticalAlignment="Center" Value="{Binding SharePercent}" />
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Opacity="0.75" HorizontalAlignment="Right"
                                                   Text="{Binding ValueLabel}" />
                                        <TextBlock FontSize="10" Opacity="0.45" HorizontalAlignment="Right"
                                                   IsVisible="{Binding HasDetailValue}"
                                                   Text="{Binding DetailValueLabel}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr stats.submarineShare}" />

                    <ItemsControl ItemsSource="{Binding SubmarineShares}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubmarineShareRowViewModel">
                                <Grid Margin="0,5" ColumnDefinitions="180,60,*,120" ColumnSpacing="12">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding SubmarineName}" />
                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                               Text="{Binding RecordCountLabel}" />
                                    <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100"
                                                 VerticalAlignment="Center" Value="{Binding SharePercent}" />
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Opacity="0.75" HorizontalAlignment="Right"
                                                   Text="{Binding ValueLabel}" />
                                        <TextBlock FontSize="10" Opacity="0.45" HorizontalAlignment="Right"
                                                   IsVisible="{Binding HasDetailValue}"
                                                   Text="{Binding DetailValueLabel}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr stats.itemShare}" />
                        <TextBlock Grid.Column="1" FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                   Text="{Binding ItemCountLabel}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ItemShareRowViewModel">
                                <Grid Margin="0,5" ColumnDefinitions="180,60,*,120" ColumnSpacing="12">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding ItemName}" />
                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                               Text="{Binding QuantityLabel}" />
                                    <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100"
                                                 VerticalAlignment="Center" Value="{Binding SharePercent}" />
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Opacity="0.75" HorizontalAlignment="Right"
                                                   Text="{Binding ValueLabel}" />
                                        <TextBlock FontSize="10" Opacity="0.45" HorizontalAlignment="Right"
                                                   IsVisible="{Binding HasDetailValue}"
                                                   Text="{Binding DetailValueLabel}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr stats.records}" />

                    <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecordRowViewModel">
                                <Grid Margin="0,6" ColumnDefinitions="100,120,*,120,Auto" ColumnSpacing="12">
                                    <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding DateLabel}" />
                                    <TextBlock Grid.Column="1" FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding CharacterLabel}" />
                                    <TextBlock Grid.Column="2" FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding DetailLabel}" />
<StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Text="{Binding TotalLabel}" />
                                        <TextBlock FontSize="10" Opacity="0.45" HorizontalAlignment="Right"
                                                   IsVisible="{Binding HasDetailTotal}"
                                                   Text="{Binding DetailTotalLabel}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" FontSize="11" Content="{loc:Tr stats.delete}"
                                            Command="{Binding DeleteCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding HasStatus}">
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding IsEmpty}">
                <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                           Text="{loc:Tr stats.empty}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
