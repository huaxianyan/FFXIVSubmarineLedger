<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FFXIVSubmarineLedger.Desktop.Localization"
             xmlns:vm="clr-namespace:FFXIVSubmarineLedger.Desktop.ViewModels"
             x:Class="FFXIVSubmarineLedger.Desktop.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel"
             x:CompileBindings="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14">

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.dataTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.dataHint}" />
                    <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding DataDirectory}" />
                    <SelectableTextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                         Text="{Binding DatabasePathLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{loc:Tr settings.openFolder}" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.backupTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.backupHint}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{loc:Tr settings.export}" Command="{Binding ExportBackupCommand}" />
                        <Button Content="{loc:Tr settings.import}" Command="{Binding ImportBackupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.languageTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.languageHint}" />
                    <ComboBox FontSize="12" MinWidth="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageChoice">
                                <TextBlock FontSize="12" Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.updateTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.updateHint}" />
                    <TextBlock FontSize="12" Opacity="0.75" Text="{Binding CurrentVersionLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{loc:Tr settings.checkNow}" Command="{Binding CheckNowCommand}" />
                        <Button Content="{loc:Tr settings.openRelease}" Command="{Binding OpenReleaseCommand}"
                                IsVisible="{Binding HasRelease}" />
                        <CheckBox Content="{loc:Tr settings.autoCheck}" IsChecked="{Binding CheckForUpdates}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               IsVisible="{Binding HasUpdateStatus}"
                               Text="{Binding UpdateStatusLabel}" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.proxyTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.proxyHint}" />
                    <ComboBox FontSize="12" MinWidth="170" HorizontalAlignment="Left"
                              ItemsSource="{Binding ProxyOptions}"
                              SelectedItem="{Binding SelectedProxy}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProxyOption">
                                <TextBlock FontSize="12" Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 自定义代理：协议、地址、端口分开填，不用用户自己拼 URL -->
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanEditProxy}">
                        <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                   Text="{loc:Tr settings.proxyProtocol}" />
                        <ComboBox FontSize="12" MinWidth="110"
                                  ItemsSource="{Binding ProtocolOptions}"
                                  SelectedItem="{Binding SelectedProtocol}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProtocolOption">
                                    <TextBlock FontSize="12" Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                   Text="{loc:Tr settings.proxyHost}" />
                        <TextBox FontSize="12" MinWidth="180"
                                 Text="{Binding ProxyHost}"
                                 PlaceholderText="{loc:Tr settings.proxyHostPlaceholder}"
                                 LostFocus="OnProxyFieldLostFocus" />

                        <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                   Text="{loc:Tr settings.proxyPort}" />
                        <TextBox FontSize="12" Width="80"
                                 Text="{Binding ProxyPort}"
                                 PlaceholderText="{loc:Tr settings.proxyPortPlaceholder}"
                                 LostFocus="OnProxyFieldLostFocus" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.recognitionTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.recognitionHint}" />
                    <SelectableTextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                         Text="{Binding CatalogLabel}" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.debugTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.debugHint}" />
                    <CheckBox Content="{loc:Tr settings.dumpChatLog}" IsChecked="{Binding DumpChatLog}" />
                    <SelectableTextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                         Text="{Binding ChatLogFolder}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{loc:Tr settings.openChatLogFolder}"
                                Command="{Binding OpenChatLogFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding HasStatus}">
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
