<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FFXIVSubmarineLedger.Desktop.Localization"
             xmlns:vm="clr-namespace:FFXIVSubmarineLedger.Desktop.ViewModels"
             x:Class="FFXIVSubmarineLedger.Desktop.Views.LedgerPageView"
             x:DataType="vm:LedgerPageViewModel"
             x:CompileBindings="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14">

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="6">
                    <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecordRowViewModel">
                                <!--
                                  艇名在上、角色在下的两行块；日期、明细、金额、删除各自成列。
                                  金额放最右的固定宽列，别让它挤到删除按钮上。
                                -->
                                <Grid Margin="0,6" ColumnDefinitions="94,150,*,130,Auto" ColumnSpacing="14">
                                    <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                               Text="{Binding DateLabel}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding SubmarineLabel}"
                                                   ToolTip.Tip="{Binding SubmarineLabel}" />
                                        <TextBlock FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CharacterLabel}"
                                                   ToolTip.Tip="{Binding CharacterLabel}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" FontSize="12" Opacity="0.6"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding DetailLabel}"
                                               ToolTip.Tip="{Binding DetailLabel}" />

                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Text="{Binding TotalLabel}" />
                                        <TextBlock FontSize="10" Opacity="0.45" HorizontalAlignment="Right"
                                                   IsVisible="{Binding HasDetailTotal}"
                                                   Text="{Binding DetailTotalLabel}" />
                                    </StackPanel>

                                    <Button Grid.Column="4" FontSize="11" VerticalAlignment="Center"
                                            Content="{loc:Tr ledger.delete}"
                                            Command="{Binding DeleteCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding IsEmpty}">
                <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                           Text="{loc:Tr ledger.empty}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
