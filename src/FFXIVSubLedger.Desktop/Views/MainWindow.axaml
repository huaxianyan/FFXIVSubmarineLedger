<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FFXIVSubLedger.Desktop.Localization"
        xmlns:vm="clr-namespace:FFXIVSubLedger.Desktop.ViewModels"
        xmlns:views="clr-namespace:FFXIVSubLedger.Desktop.Views"
        x:Class="FFXIVSubLedger.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr app.title}"
        Width="1200"
        Height="800"
        MinWidth="960"
        MinHeight="640">

    <Window.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="Background" Value="#0A808080" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#16808080" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#285B8DEF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*" RowDefinitions="*,Auto">
        <Border Grid.RowSpan="2" Background="#0E808080"
                BorderBrush="#40808080" BorderThickness="0,0,1,0">
            <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Margin="8,10,8,22" Spacing="4">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="{loc:Tr app.brand}" />
                    <TextBlock FontSize="12" Opacity="0.6" Text="Sub Ledger" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Classes.nav="True" Classes.active="{Binding IsRecordsPage}"
                            Command="{Binding ShowRecordsCommand}" Content="{loc:Tr nav.records}" />
                    <Button Classes.nav="True" Classes.active="{Binding IsStatisticsPage}"
                            Command="{Binding ShowStatisticsCommand}" Content="{loc:Tr nav.statistics}" />
                    <Button Classes.nav="True" Classes.active="{Binding IsCharactersPage}"
                            Command="{Binding ShowCharactersCommand}" Content="{loc:Tr nav.characters}" />
                    <Button Classes.nav="True" Classes.active="{Binding IsSettingsPage}"
                            Command="{Binding ShowSettingsCommand}" Content="{loc:Tr nav.settings}" />
                </StackPanel>

                <Border Grid.Row="3" Classes="card" Padding="12">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{loc:Tr main.statusHeading}" />
                        <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                   MaxLines="4" Text="{Binding StatusMessage}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Padding="28,20" BorderBrush="#40808080" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="page-title" Text="{Binding PageTitle}" />
                        <TextBlock Opacity="0.65" Text="{Binding PageSubtitle}" />
                    </StackPanel>

                    <!-- 筛选只在收益统计页出现，放在标题这一栏，滚动时不跟着滚走 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center" Margin="24,0,24,0"
                                IsVisible="{Binding IsStatisticsPage}">
                        <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                   Text="{loc:Tr stats.character}" />
                        <ComboBox FontSize="12" MinWidth="170"
                                  ItemsSource="{Binding Statistics.CharacterOptions}"
                                  SelectedItem="{Binding Statistics.SelectedCharacter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterOption">
                                    <TextBlock FontSize="12" Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                   Text="{loc:Tr stats.submarine}" />
                        <ComboBox FontSize="12" MinWidth="150"
                                  IsEnabled="{Binding Statistics.CanFilterBySubmarine}"
                                  ItemsSource="{Binding Statistics.SubmarineOptions}"
                                  SelectedItem="{Binding Statistics.SelectedSubmarine}"
                                  ToolTip.Tip="{loc:Tr stats.subFilterHint}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterOption">
                                    <TextBlock FontSize="12" Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <ProgressBar Width="90" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                        <Button Command="{Binding RefreshCommand}" Content="{loc:Tr main.refresh}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Panel Grid.Row="1" IsVisible="{Binding IsRecordsPage}">
                <views:RecordsPageView DataContext="{Binding Records}" />
            </Panel>
            <Panel Grid.Row="1" IsVisible="{Binding IsStatisticsPage}">
                <views:StatisticsPageView DataContext="{Binding Statistics}" />
            </Panel>
            <Panel Grid.Row="1" IsVisible="{Binding IsCharactersPage}">
                <views:CharacterManagerView DataContext="{Binding Characters}" />
            </Panel>
            <Panel Grid.Row="1" IsVisible="{Binding IsSettingsPage}">
                <views:SettingsPageView DataContext="{Binding Settings}" />
            </Panel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Padding="28,10" BorderBrush="#40808080"
                BorderThickness="0,1,0,0">
            <TextBlock FontSize="12" Opacity="0.65"
                       Text="{loc:Tr main.footer}" />
        </Border>
    </Grid>
</Window>
