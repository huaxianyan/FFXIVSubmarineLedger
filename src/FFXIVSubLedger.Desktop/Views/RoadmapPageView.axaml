<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FFXIVSubLedger.Desktop.ViewModels"
             x:Class="FFXIVSubLedger.Desktop.Views.RoadmapPageView"
             x:DataType="vm:RoadmapPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14">
            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <TextBlock Opacity="0.78" TextWrapping="Wrap" Text="{Binding Description}" />
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="计划中的流程" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoadmapStepViewModel">
                                <Grid Margin="0,4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="24" Height="24" CornerRadius="12"
                                            Background="#285B8DEF" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Order}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.8"
                                               TextWrapping="Wrap" Text="{Binding Text}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <TextBlock FontSize="12" Opacity="0.62" TextWrapping="Wrap" Text="{Binding Footnote}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
