<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FFXIVSubLedger.Desktop.ViewModels"
             xmlns:controls="clr-namespace:FFXIVSubLedger.Desktop.Controls"
             x:Class="FFXIVSubLedger.Desktop.Views.StatisticsPageView"
             x:DataType="vm:StatisticsPageViewModel"
             x:CompileBindings="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14">

            <Border Padding="16" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock FontSize="12" Opacity="0.6" VerticalAlignment="Center" Text="筛选" />

                    <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center" Text="角色" />
                    <ComboBox FontSize="12" MinWidth="200"
                              ItemsSource="{Binding CharacterOptions}"
                              SelectedItem="{Binding SelectedCharacter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilterOption">
                                <TextBlock FontSize="12" Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center" Text="艇" />
                    <ComboBox FontSize="12" MinWidth="180"
                              IsEnabled="{Binding CanFilterBySubmarine}"
                              ItemsSource="{Binding SubmarineOptions}"
                              SelectedItem="{Binding SelectedSubmarine}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilterOption">
                                <TextBlock FontSize="12" Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                               Text="艇名只在角色范围内唯一，所以筛艇要先选角色。" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="历史总收益" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding TotalLabel}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="日均" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding AveragePerDayLabel}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="月均" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding AveragePerMonthLabel}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Padding="16" CornerRadius="10" BorderThickness="1"
                        BorderBrush="#40808080" Background="#0A808080">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Opacity="0.6" Text="年均" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding AveragePerYearLabel}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="16" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap" Text="{Binding SpanLabel}" />
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TrendTitle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button FontSize="11" Content="按日" Command="{Binding ShowDailyCommand}" />
                            <Button FontSize="11" Content="按月" Command="{Binding ShowMonthlyCommand}" />
                            <Button FontSize="11" Content="导出 CSV" Command="{Binding ExportCsvCommand}" />
                        </StackPanel>
                    </Grid>
                    <controls:TrendChart Height="170" Series="{Binding Trend}" />
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="角色占比" />

                    <ItemsControl ItemsSource="{Binding Characters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterShareRowViewModel">
                                <Grid Margin="0,5" ColumnDefinitions="180,60,*,120" ColumnSpacing="12">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding CharacterName}" />
                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                               Text="{Binding RecordCountLabel}" />
                                    <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100"
                                                 VerticalAlignment="Center" Value="{Binding SharePercent}" />
                                    <TextBlock Grid.Column="3" FontSize="12" Opacity="0.75"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding ValueLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="按艇占比" />

                    <ItemsControl ItemsSource="{Binding SubmarineShares}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubmarineShareRowViewModel">
                                <Grid Margin="0,5" ColumnDefinitions="180,60,*,120" ColumnSpacing="12">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding SubmarineName}" />
                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                               Text="{Binding RecordCountLabel}" />
                                    <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100"
                                                 VerticalAlignment="Center" Value="{Binding SharePercent}" />
                                    <TextBlock Grid.Column="3" FontSize="12" Opacity="0.75"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding ValueLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="道具占比" />
                        <TextBlock Grid.Column="1" FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                   Text="{Binding ItemCountLabel}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ItemShareRowViewModel">
                                <Grid Margin="0,5" ColumnDefinitions="180,60,*,120" ColumnSpacing="12">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding ItemName}" />
                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                               Text="{Binding QuantityLabel}" />
                                    <ProgressBar Grid.Column="2" Height="6" Minimum="0" Maximum="100"
                                                 VerticalAlignment="Center" Value="{Binding SharePercent}" />
                                    <TextBlock Grid.Column="3" FontSize="12" Opacity="0.75"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding ValueLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080"
                    IsVisible="{Binding HasRecords}">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="已入账记录" />

                    <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecordRowViewModel">
                                <Grid Margin="0,6" ColumnDefinitions="100,120,*,120,Auto" ColumnSpacing="12">
                                    <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding DateLabel}" />
                                    <TextBlock Grid.Column="1" FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding CharacterLabel}" />
                                    <TextBlock Grid.Column="2" FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding DetailLabel}" />
                                    <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding TotalLabel}" />
                                    <Button Grid.Column="4" FontSize="11" Content="删除"
                                            Command="{Binding DeleteCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding HasStatus}">
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding IsEmpty}">
                <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                           Text="还没有记录。到「收艇记账」页截图识别一次，确认后就会出现在这里。" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
