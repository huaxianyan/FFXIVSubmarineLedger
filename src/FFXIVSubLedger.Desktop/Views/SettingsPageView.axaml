<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FFXIVSubLedger.Desktop.ViewModels"
             x:Class="FFXIVSubLedger.Desktop.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel"
             x:CompileBindings="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14">

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="数据位置" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="数据库与备份都在这个目录里，整个目录复制走就等于搬家。" />
                    <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding DataDirectory}" />
                    <SelectableTextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                         Text="{Binding DatabasePathLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="打开数据目录" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="备份" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="导出是可读的 JSON 文件，不用本程序也能看懂。导入会整体替换当前数据，替换前会自动把现有数据存一份到数据目录的 backups 里。" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="导出备份" Command="{Binding ExportBackupCommand}" />
                        <Button Content="导入备份" Command="{Binding ImportBackupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="识别" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="日文 OCR 模型与掉落表都随程序分发，不依赖系统语言包，也不需要联网。" />
                    <SelectableTextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                         Text="{Binding CatalogLabel}" />
                </StackPanel>
            </Border>

            <Border Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding HasStatus}">
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
