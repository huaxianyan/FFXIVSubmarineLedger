<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FFXIVSubLedger.Desktop.Localization"
             xmlns:vm="clr-namespace:FFXIVSubLedger.Desktop.ViewModels"
             x:Class="FFXIVSubLedger.Desktop.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel"
             x:CompileBindings="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14">

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.dataTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.dataHint}" />
                    <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding DataDirectory}" />
                    <SelectableTextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                         Text="{Binding DatabasePathLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{loc:Tr settings.openFolder}" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.backupTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.backupHint}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{loc:Tr settings.export}" Command="{Binding ExportBackupCommand}" />
                        <Button Content="{loc:Tr settings.import}" Command="{Binding ImportBackupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.languageTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.languageHint}" />
                    <ComboBox FontSize="12" MinWidth="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageChoice">
                                <TextBlock FontSize="12" Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr settings.recognitionTitle}" />
                    <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Tr settings.recognitionHint}" />
                    <SelectableTextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                         Text="{Binding CatalogLabel}" />
                </StackPanel>
            </Border>

            <Border Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding HasStatus}">
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
