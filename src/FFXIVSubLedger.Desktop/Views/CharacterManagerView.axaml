<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FFXIVSubLedger.Desktop.Localization"
             xmlns:vm="clr-namespace:FFXIVSubLedger.Desktop.ViewModels"
             x:Class="FFXIVSubLedger.Desktop.Views.CharacterManagerView"
             x:DataType="vm:CharacterManagerViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" Spacing="14">

            <Border Padding="18" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#0A808080">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr characters.addTitle}" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="{loc:Tr characters.addHint}" />
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                        <TextBox PlaceholderText="{loc:Tr characters.namePlaceholder}" Text="{Binding NewName}" />
                        <TextBox Grid.Column="1" PlaceholderText="{loc:Tr characters.worldPlaceholder}" Text="{Binding NewWorld}" />
                        <Button Grid.Column="2" Classes="accent" Content="{loc:Tr characters.add}"
                                Command="{Binding AddCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="14" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding HasStatus}">
                <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                           Text="{Binding StatusMessage}" />
            </Border>

            <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Tr characters.listTitle}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Opacity="0.65"
                           Text="{Binding CountLabel}" />
            </Grid>

            <Border Padding="28" CornerRadius="10" BorderThickness="1"
                    BorderBrush="#40808080" Background="#07808080"
                    IsVisible="{Binding !HasCharacters}">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Text="{loc:Tr characters.empty}" />
                    <TextBlock FontSize="12" Opacity="0.65" HorizontalAlignment="Center"
                               Text="{loc:Tr characters.emptyHint}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterRowViewModel">
                        <Border Margin="0,0,0,8" Padding="18,14" CornerRadius="10"
                                BorderThickness="1" BorderBrush="#40808080" Background="#0A808080">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding Name}" />
                                    <Border CornerRadius="4" Padding="7,2" Background="#285B8DEF"
                                            VerticalAlignment="Center" IsVisible="{Binding IsDefault}">
                                        <TextBlock FontSize="11" Text="{loc:Tr characters.default}" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="7,2" Background="#1A808080"
                                            VerticalAlignment="Center" IsVisible="{Binding IsInactive}">
                                        <TextBlock FontSize="11" Opacity="0.8" Text="{loc:Tr characters.inactive}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="1" FontSize="12" Opacity="0.65"
                                           Text="{Binding WorldLabel}" />

                                <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal"
                                            Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{loc:Tr characters.setDefault}" Command="{Binding SetDefaultCommand}"
                                            IsVisible="{Binding CanSetDefault}" />
                                    <Button Content="{Binding ToggleLabel}"
                                            Command="{Binding ToggleActiveCommand}" />
                                    <Button Content="{loc:Tr characters.delete}" Command="{Binding DeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
