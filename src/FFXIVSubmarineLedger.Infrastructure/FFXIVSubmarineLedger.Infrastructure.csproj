<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft.Data.Sqlite 的版本同时决定 SQLitePCLRaw 的版本（10.0.0 → 2.1.11，10.0.15 → 2.1.13）。
         2.1.11 及以下带着 CVE-2025-6965（GHSA-2m69-gcr7-jv3q，高），NuGet 审计会直接判构建失败，别往回降。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FFXIVSubmarineLedger.Domain\FFXIVSubmarineLedger.Domain.csproj" />
    <ProjectReference Include="..\FFXIVSubmarineLedger.Application\FFXIVSubmarineLedger.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 掉落表随程序分发，用户可查看、可手工补。 -->
    <None Include="Data\items.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
